)
# Optional legend
legend(
"topright",
legend = c("Actual Data", "Prediction Line"),
col = c("steelblue", "red"),
pch = c(16, NA),
lty = c(NA, 1),
lwd = c(NA, 3)
)
# Standardize variables
Xtrain = as.matrix(log(dat$annual_income))
Ytrain = as.matrix(dat$credit_utilisation_pct)
# Train model
model = babynet.fit(
Xtrain,
Ytrain,
h_nodes = c(8,16),
h_activation = "tanh",
objective = "squared_error",
seed = 42,
iterations = 500
)
# Plot objective function
babynet.plot(model, "objective")
pred = babynet.predict(model=model, X=Xtrain)
# Convert matrices to vectors
x = as.numeric(Xtrain)
y = as.numeric(Ytrain)
pred = as.numeric(pred$Yhat)
# Order values for smooth line
ord = order(x)
# Scatter plot
plot(
x,
y,
pch = 16,
col = "steelblue",
xlab = "Annual Income",
ylab = "Credit Utilisation",
main = "Neural Network Prediction"
)
# Prediction line
lines(
x[ord],
pred[ord],
col = "red",
lwd = 3
)
# Optional legend
legend(
"topright",
legend = c("Actual Data", "Prediction Line"),
col = c("steelblue", "red"),
pch = c(16, NA),
lty = c(NA, 1),
lwd = c(NA, 3)
)
# Calculate quartiles
Q1 = quantile(dat$annual_income, 0.25, na.rm = TRUE)
Q3 = quantile(dat$annual_income, 0.75, na.rm = TRUE)
# Calculate IQR
IQR_value = IQR(dat$annual_income, na.rm = TRUE)
# Define bounds
lower_bound = Q1 - 1.5 * IQR_value
upper_bound = Q3 + 1.5 * IQR_value
# Cap values
dat$annual_income = ifelse(
dat$annual_income < lower_bound,
lower_bound,
ifelse(
dat$annual_income > upper_bound,
upper_bound,
dat$annual_income
)
)
# Summary after capping
summary(dat$annual_income)
